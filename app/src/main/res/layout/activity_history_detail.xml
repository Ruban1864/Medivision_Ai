<?xml version="1.0" encoding="utf-8"?>

<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/colorBackground">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Page Header -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Medical Report Details"
            android:textSize="24sp"
            android:textStyle="bold"
            android:textColor="@color/textPrimary"
            android:gravity="center"
            android:layout_marginBottom="16dp"/>

        <!-- Report Name Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@color/colorSurface"
            android:padding="16dp"
            android:elevation="3dp"
            android:layout_marginBottom="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Report Name"
                android:textColor="@color/colorPrimary"
                android:textStyle="bold"
                android:textSize="14sp"/>

            <TextView
                android:id="@+id/tv_report_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Blood Test Report"
                android:textSize="18sp"
                android:textColor="@color/textPrimary"
                android:layout_marginTop="4dp"/>
        </LinearLayout>


        <!-- Report URL Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@color/colorSurface"
            android:padding="16dp"
            android:elevation="3dp"
            android:layout_marginBottom="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Report URL"
                android:textColor="@color/colorSecondary"
                android:textStyle="bold"
                android:textSize="14sp"/>

            <TextView
                android:id="@+id/tv_report_url"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="https://cloudinary.com/..."
                android:textColor="@color/textSecondary"
                android:textSize="14sp"
                android:textIsSelectable="true"
                android:layout_marginTop="4dp"/>
        </LinearLayout>


        <!-- Extracted Data Table -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@color/colorSurface"
            android:padding="16dp"
            android:elevation="3dp"
            android:layout_marginBottom="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Extracted Medical Parameters"
                android:textColor="@color/colorPrimary"
                android:textStyle="bold"
                android:textSize="16sp"
                android:layout_marginBottom="10dp"/>

            <TableLayout
                android:id="@+id/table_extracted_data"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:stretchColumns="1">

                <!-- Table Header -->
                <TableRow>

                    <TextView
                        android:text="Parameter"
                        android:textStyle="bold"
                        android:textColor="@color/textPrimary"
                        android:padding="6dp"/>

                    <TextView
                        android:text="Value"
                        android:textStyle="bold"
                        android:textColor="@color/textPrimary"
                        android:padding="6dp"/>
                </TableRow>

            </TableLayout>

        </LinearLayout>


        <!-- AI Summary Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@color/colorSurface"
            android:padding="16dp"
            android:elevation="3dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="AI Health Summary"
                android:textColor="@color/colorAccent"
                android:textStyle="bold"
                android:textSize="16sp"
                android:layout_marginBottom="8dp"/>

            <TextView
                android:id="@+id/tv_summary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/textPrimary"
                android:textSize="15sp"
                android:lineSpacingExtra="4dp"
                android:textIsSelectable="true"/>

        </LinearLayout>

    </LinearLayout>

</ScrollView>